{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "realtime-screen-translator",
  "version": "0.1.0",
  "identifier": "ai.littlebit.realtime-screen-translator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "실시간 화면 번역",
        "width": 420,
        "height": 760
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
